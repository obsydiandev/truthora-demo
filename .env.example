# Truthora — Environment Configuration
# Copy this file to .env and fill in the values.

# --- LLM Provider ---
# Options: "groq" or "ollama"
LLM_PROVIDER=ollama

# Groq API (used when LLM_PROVIDER=groq)
GROQ_API_KEY=

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Qdrant Vector DB ---
# Use 'qdrant' (Docker service name) when running via docker compose
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# --- Google Fact Check Tools API ---
GOOGLE_FC_API_KEY=

# --- Embeddings ---
# BGE-M3 model name (loaded locally via sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-m3

# --- Application ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
# Use 'api' (Docker service name) when running via docker compose
API_URL=http://api:8000
